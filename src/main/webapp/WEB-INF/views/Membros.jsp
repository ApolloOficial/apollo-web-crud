<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Apollo - Membros</title>

    <link rel="stylesheet" href="Apollostyle.css">
</head>

<body>

    <div class="pagina">

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <div class="logo">
                <span>apollo</span>
            </div>

            <nav class="menu">

                <a href="#" class="menu-item">
                    Dashboard
                </a>

                <a href="#" class="menu-item">
                    Lotes
                </a>

                <a href="#" class="menu-item">
                    Manutenções
                </a>

                <a href="#" class="menu-item">
                    Filiais
                </a>

                <a href="#" class="menu-item ativo">
                    Membros
                </a>

                <a href="#" class="menu-item">
                    Realocações
                </a>

                <a href="#" class="menu-item">
                    Metas
                </a>

            </nav>

            <div class="menu-baixo">

                <a href="#" class="menu-item">
                    Configurações
                </a>

            </div>

        </aside>


        <!-- CONTEÚDO PRINCIPAL -->
        <main class="conteudo">

            <!-- TOPO -->
            <header class="topo">

                <h1 class="titulo">
                    Membros
                </h1>

                <div class="usuario">
                    <span>Neymar júnior césar</span>
                    <span class="seta">▼</span>
                </div>

            </header>


            <!-- STATUS -->
            <span class="status-titulo">
                Status de membros
            </span>


            <section class="cards-status">

                <div class="status-card">

                    <div class="status-info">
                        <span class="nome">
                            Total de membros
                        </span>

                        <span class="numero">
                            58
                        </span>
                    </div>

                </div>


                <div class="status-card">

                    <div class="status-info">
                        <span class="nome">
                            Lotes
                        </span>

                        <span class="numero">
                            10
                        </span>
                    </div>

                </div>


                <div class="status-card">

                    <div class="status-info">
                        <span class="nome">
                            Membros por lote(média)
                        </span>

                        <span class="numero">
                            5,8
                        </span>
                    </div>

                </div>


                <div class="status-card">

                    <div class="status-info">
                        <span class="nome">
                            Maior lote
                        </span>

                        <span class="numero">
                            N° 14: 8 membros
                        </span>
                    </div>

                </div>

            </section>


            <!-- ÁREA DOS MEMBROS -->
            <section class="area-membros">

                <div class="barra-superior">

                    <div class="busca-area">

                        <div class="busca">

                            <span class="lupa"></span>

                            <input
                                type="text"
                                placeholder="Busque pelo nome de seu membro"
                            >

                        </div>

                        <button class="filtro" aria-label="Filtrar">
                            ☰
                        </button>

                    </div>


                    <button class="botao-adicionar">
                        + Adicionar membro
                    </button>

                </div>


                <!-- TABELA -->
                <div class="tabela-container">

                    <table>

                        <thead>

                            <tr>
                                <th>Nome</th>
                                <th>Localização</th>
                                <th>Posto</th>
                                <th>Alocação</th>
                                <th></th>
                            </tr>

                        </thead>


                        <tbody>

                            <tr>

                                <td>
                                    José Araújo
                                </td>

                                <td>
                                    Rua das flores, 123 - São Paulo SP
                                </td>

                                <td>
                                    <span class="cargo engenheiro">
                                        Engenheiro Eletricista
                                    </span>
                                </td>

                                <td>
                                    Alocado no lote 14
                                </td>

                                <td>
                                    <button class="perfil">
                                        Ver Perfil
                                    </button>
                                </td>

                            </tr>


                            <tr>

                                <td>
                                    Jairo Zeppeli
                                </td>

                                <td>
                                    Xique Xique, 123 - Bahia
                                </td>

                                <td>
                                    <span class="cargo tecnico">
                                        Técnico de Manutenção
                                    </span>
                                </td>

                                <td>
                                    Alocado no lote 15
                                </td>

                                <td>
                                    <button class="perfil">
                                        Ver Perfil
                                    </button>
                                </td>

                            </tr>


                            <tr>

                                <td>
                                    Jailson Mendes
                                </td>

                                <td>
                                    Rua das flores, 123 - São Paulo SP
                                </td>

                                <td>
                                    <span class="cargo engenheiro">
                                        Engenheiro auxiliar
                                    </span>
                                </td>

                                <td>
                                    Alocado no lote 14
                                </td>

                                <td>
                                    <button class="perfil">
                                        Ver Perfil
                                    </button>
                                </td>

                            </tr>


                            <tr>

                                <td>
                                    José Araújo
                                </td>

                                <td>
                                    Rua das flores, 123 - São Paulo SP
                                </td>

                                <td>
                                    <span class="cargo engenheiro">
                                        Engenheiro Eletricista
                                    </span>
                                </td>

                                <td>
                                    Alocado no lote 14
                                </td>

                                <td>
                                    <button class="perfil">
                                        Ver Perfil
                                    </button>
                                </td>

                            </tr>


                            <tr>

                                <td>
                                    Jairo Zeppeli
                                </td>

                                <td>
                                    Xique Xique, 123 - Bahia
                                </td>

                                <td>
                                    <span class="cargo tecnico">
                                        Técnico de Manutenção
                                    </span>
                                </td>

                                <td>
                                    Alocado no lote 15
                                </td>

                                <td>
                                    <button class="perfil">
                                        Ver Perfil
                                    </button>
                                </td>

                            </tr>


                            <tr>

                                <td>
                                    Jailson Mendes
                                </td>

                                <td>
                                    Rua das flores, 123 - São Paulo SP
                                </td>

                                <td>
                                    <span class="cargo engenheiro">
                                        Engenheiro auxiliar
                                    </span>
                                </td>

                                <td>
                                    Alocado no lote 14
                                </td>

                                <td>
                                    <button class="perfil">
                                        Ver Perfil
                                    </button>
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </section>

        </main>

    </div>

</body>

</html>